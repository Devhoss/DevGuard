<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xxl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/header_logo"
                android:layout_height="@dimen/header_logo"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tile"
                    android:tint="@color/mint" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Mode card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_card_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mode_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/hero_label" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/header_current_mode"
                    android:textAppearance="@style/Text.CardLabel" />
            </LinearLayout>

            <TextView
                android:id="@+id/mode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/mode_dev"
                android:textAppearance="@style/Text.CardTitle" />

            <TextView
                android:id="@+id/mode_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/mode_dev_desc"
                android:textAppearance="@style/Text.CardBody" />

            <TextView
                android:id="@+id/mode_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_safe"
                android:textColor="@color/navy"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Debugging -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/section_debugging"
            android:textAppearance="@style/Text.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <!-- Developer options -->
            <LinearLayout
                android:id="@+id/row_dev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="78dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:layout_width="@dimen/row_icon_box"
                    android:layout_height="@dimen/row_icon_box"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="@dimen/row_icon_size"
                        android:layout_height="@dimen/row_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dev_options"
                        android:tint="@color/accent_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dev_options_title"
                        android:textAppearance="@style/Text.RowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dev_options_desc"
                        android:textAppearance="@style/Text.RowDesc" />

                    <TextView
                        android:id="@+id/status_dev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/state_off"
                        android:textAppearance="@style/Text.RowStatus" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@null"
                    android:showText="false"
                    android:splitTrack="false"
                    android:switchMinWidth="56dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="70dp"
                android:background="@color/divider" />

            <!-- USB debugging -->
            <LinearLayout
                android:id="@+id/row_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="78dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:layout_width="@dimen/row_icon_box"
                    android:layout_height="@dimen/row_icon_box"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="@dimen/row_icon_size"
                        android:layout_height="@dimen/row_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_usb"
                        android:tint="@color/accent_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usb_title"
                        android:textAppearance="@style/Text.RowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/usb_desc"
                        android:textAppearance="@style/Text.RowDesc" />

                    <TextView
                        android:id="@+id/status_usb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/state_off"
                        android:textAppearance="@style/Text.RowStatus" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_usb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@null"
                    android:showText="false"
                    android:splitTrack="false"
                    android:switchMinWidth="56dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="70dp"
                android:background="@color/divider" />

            <!-- Wireless debugging -->
            <LinearLayout
                android:id="@+id/row_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="78dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:layout_width="@dimen/row_icon_box"
                    android:layout_height="@dimen/row_icon_box"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="@dimen/row_icon_size"
                        android:layout_height="@dimen/row_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wireless"
                        android:tint="@color/accent_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_title"
                        android:textAppearance="@style/Text.RowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/wifi_desc"
                        android:textAppearance="@style/Text.RowDesc" />

                    <TextView
                        android:id="@+id/status_wifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/state_off"
                        android:textAppearance="@style/Text.RowStatus" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:background="@null"
                    android:showText="false"
                    android:splitTrack="false"
                    android:switchMinWidth="56dp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- Snapshot -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/section_snapshot"
            android:textAppearance="@style/Text.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_snapshot"
                        android:tint="@color/accent_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/snapshot_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/snapshot_none"
                        android:textAppearance="@style/Text.CardHeading" />

                    <TextView
                        android:id="@+id/snapshot_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/snapshot_none_desc"
                        android:textAppearance="@style/Text.CardDetail" />
                </LinearLayout>

                <TextView
                    android:id="@+id/snapshot_manage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/snapshot_manage"
                    android:textColor="@color/accent_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/snapshot_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/snapshot_restore"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/action_restore_short"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Permission -->
        <LinearLayout
            android:id="@+id/permission_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_card_warn"
            android:orientation="vertical"
            android:padding="@dimen/space_l"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warn"
                    android:tint="@color/warn_ink" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/setup_required"
                    android:textAppearance="@style/Text.CardHeading" />
            </LinearLayout>

            <TextView
                android:id="@+id/permission_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:lineSpacingExtra="2dp"
                android:text="@string/setup_required_body"
                android:textAppearance="@style/Text.CardDetail" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_copy_command"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/setup_copy_command"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_setup"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/setup_open_guide"
                    android:textColor="@color/navy"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/about_note"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
