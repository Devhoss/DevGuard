<?xml version="1.0" encoding="utf-8"?>
<!-- Development Mode: mint track, navy thumb parked right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/mint" />
            <size android:width="44dp" android:height="26dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="21dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/navy" />
        </shape>
    </item>
</layer-list>
