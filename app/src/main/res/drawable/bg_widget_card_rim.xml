<?xml version="1.0" encoding="utf-8"?>
<!-- Default surface, specular rim ON: normal card, brighter hairline edge and a
     thin top reflection arc that reads as light catching the rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/widget_card" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_rim" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:left="10dp"
        android:right="10dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <solid android:color="@color/widget_sheen" />
        </shape>
    </item>
</layer-list>
